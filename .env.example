# Where the contact form sends each message, as a JSON POST.
# Until this is set, the form tells visitors honestly that it is not connected yet.
# Works with any service that accepts a webhook: Formspree, Make, Zapier, n8n, a Slack workflow, or your own endpoint.
CONTACT_WEBHOOK_URL=

# Run npm run hr:setup to generate PAYLOAD_SECRET in .env.local.
# Add these to that file for a persistent production host; do not overwrite its secret.
# NEXT_PUBLIC_SERVER_URL=https://www.parttagency.com
# CAREERS_DATA_DIR=/private/persistent/partt-careers
# TRUST_PROXY=false
# DATABASE_URI=file:/private/persistent/partt-careers/careers.db
# DATABASE_AUTH_TOKEN=      # only if a remote libSQL database requires it
